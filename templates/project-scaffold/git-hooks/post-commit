#!/bin/sh
# CraftXTech Multi-Agent Git Hook
# Tự động nhận diện Feature Slug, cập nhật STATE.json và gửi thông báo push về điện thoại

LAST_COMMIT_MSG=$(git log -1 --pretty=%B)

if [ -f ".agents/STATE.json" ]; then
  COMMIT_MSG="$LAST_COMMIT_MSG" node -e '
    const fs = require("fs");
    const path = require("path");
    const https = require("https");

    const commitMsg = process.env.COMMIT_MSG || "";
    // Regex khớp: [TAG](slug): hoặc [TAG]:
    const match = commitMsg.match(/\[(AG-PM|CODEX-ASTRA|AG-DEV|AG-QA)\](?:\(([^)]+)\))?/);
    if (!match) process.exit(0);

    const tag = match[1];
    const slug = match[2] || "default";
    const nowIso = new Date().toISOString();

    const rootStateFile = path.join(".agents", "STATE.json");
    let rootState = {};
    try { rootState = JSON.parse(fs.readFileSync(rootStateFile, "utf8")); } catch(e) {}
    if (!rootState.active_features) rootState.active_features = {};
    if (!rootState.active_features[slug]) rootState.active_features[slug] = {};

    let newPhase = "";
    let lastActor = "";
    let notifyText = "";

    if (tag === "AG-PM") {
      newPhase = "AWAITING_ASTRA";
      lastActor = "antigravity_pm";
      notifyText = "PM đã commit PRD cho [" + slug + "]! Hãy mở Codex gõ /next";
    } else if (tag === "CODEX-ASTRA") {
      newPhase = "AWAITING_DEV";
      lastActor = "codex_astra";
      notifyText = "Astra đã lên Plan cho [" + slug + "]! Mở Antigravity gõ /next";
    } else if (tag === "AG-DEV") {
      newPhase = "VERIFYING";
      lastActor = "antigravity_dev";
    } else if (tag === "AG-QA") {
      newPhase = "COMPLETED";
      lastActor = "antigravity_qa";
      notifyText = "Tính năng [" + slug + "] đã PASS toàn bộ kiểm thử!";
    }

    // 1. Cập nhật Root STATE.json
    rootState.active_features[slug].phase = newPhase;
    rootState.active_features[slug].last_actor = lastActor;
    rootState.active_features[slug].updated_at = nowIso;
    fs.writeFileSync(rootStateFile, JSON.stringify(rootState, null, 2));

    // 2. Cập nhật Feature-specific STATE.json nếu tồn tại
    const featStateFile = path.join(".agents", "features", slug, "STATE.json");
    if (fs.existsSync(path.dirname(featStateFile))) {
      let featState = {};
      try { featState = JSON.parse(fs.readFileSync(featStateFile, "utf8")); } catch(e) {}
      featState.phase = newPhase;
      featState.last_actor = lastActor;
      featState.updated_at = nowIso;
      fs.writeFileSync(featStateFile, JSON.stringify(featState, null, 2));
    }

    console.log("⚡ [Hook]: Đã cập nhật trạng thái [" + slug + "] -> " + newPhase);

    // 3. Gửi push notification nếu có channel
    if (notifyText && rootState.notification_channel) {
      const req = https.request("https://ntfy.sh/" + rootState.notification_channel, {
        method: "POST",
        headers: { "Content-Type": "text/plain", "Title": "CraftXTech Agent Alert" }
      });
      req.on("error", () => {});
      req.write(notifyText);
      req.end();
    }
  '
fi
