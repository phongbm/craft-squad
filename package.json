{
  "name": "craft-squad-workspace",
  "version": "3.1.0",
  "private": true,
  "description": "CraftSquad Monorepo: Antigravity Plugin & Local Management Dashboard",
  "workspaces": [
    "plugin",
    "tool"
  ],
  "bin": {
    "craft-squad": "./plugin/bin/cli.js"
  },
  "scripts": {
    "start": "node tool/server.js",
    "tool:start": "node tool/server.js",
    "tool:dev": "node tool/server.js",
    "cx": "node tool/bin/cx.js",
    "codex": "node tool/bin/cx.js",
    "codex:list": "node tool/bin/cx.js list",
    "codex:rotate": "node tool/bin/cx.js rotate",
    "codex:sync": "node tool/bin/cx.js sync",
    "codex:doctor": "node tool/bin/cx.js doctor",
    "test": "npm --prefix plugin run test:dispatcher && node tool/test/run.js",
    "plugin:test": "npm --prefix plugin run test:dispatcher",
    "plugin:status": "node plugin/bin/cli.js status",
    "plugin:install": "node plugin/bin/cli.js install",
    "plugin:update": "node plugin/bin/cli.js update",
    "plugin:upgrade": "node plugin/bin/cli.js upgrade",
    "plugin:uninstall": "node plugin/bin/cli.js uninstall",
    "plugin:config": "node plugin/bin/cli.js config",
    "plugin:dispatch": "node plugin/bin/cli.js dispatch",
    "tool:test": "node tool/test/run.js"
  },
  "keywords": [
    "craft-squad",
    "antigravity-plugin",
    "codex-switcher",
    "agent-team",
    "multi-agent",
    "claude-code",
    "codex"
  ],
  "author": "CraftX Tech",
  "repository": {
    "type": "git",
    "url": "https://github.com/phongbm/craft-squad.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
