{
  "name": "craft-squad-workspace",
  "version": "3.1.0",
  "private": true,
  "description": "CraftSquad Monorepo: Antigravity Plugin & Local Management Dashboard",
  "scripts": {
    "start": "node tool/server.js",
    "tool:start": "node tool/server.js",
    "tool:dev": "node tool/server.js",
    "plugin:test": "npm --prefix plugin run test:dispatcher",
    "plugin:status": "node plugin/bin/cli.js status",
    "plugin:install": "node plugin/bin/cli.js install",
    "plugin:upgrade": "node plugin/bin/cli.js upgrade",
    "plugin:uninstall": "node plugin/bin/cli.js uninstall",
    "plugin:config": "node plugin/bin/cli.js config",
    "plugin:dispatch": "node plugin/bin/cli.js dispatch",
    "sync:upstream": "node plugin/scripts/sync-upstream.js"
  },
  "keywords": [
    "craft-squad",
    "antigravity-plugin",
    "codex-switcher",
    "agent-team",
    "multi-agent",
    "claude-code",
    "codex"
  ],
  "author": "CraftXTech Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
